{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":disableRateLimiting",
    ":dependencyDashboard",
    ":semanticCommits",
    "schedule:daily"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "ansible"
      ],
      "pinDigests": false
    },
    {
      "description": "Group minor and patch image bumps into one PR. Majors stay out of the group, so each one gets its own PR to review against its release notes.",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "ansible"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Ansible Docker Images"
    }
  ],
  "terraform": {
    "enabled": true
  },
  "ansible": {
    "managerFilePatterns": [
      "/tasks/docker/.+\\.ya?ml$/"
    ]
  },
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "{{ secrets.MEND_DOCKER_USERNAME }}",
      "password": "{{ secrets.MEND_DOCKER_TOKEN }}"
    },
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "{{ secrets.MEND_GITHUB_USERNAME }}",
      "password": "{{ secrets.MEND_GITHUB_TOKEN }}"
    }
  ]
}
