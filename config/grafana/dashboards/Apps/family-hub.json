              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "up{job=\"family-hub\"}",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ]
    },
    {
      "title": "Requests / second",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(familyhub_http_requests_total{job=\"family-hub\"}[$__rate_interval]))",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ]
    },
    {
      "title": "5xx Error Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(familyhub_http_requests_total{job=\"family-hub\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(familyhub_http_requests_total{job=\"family-hub\"}[$__rate_interval])), 0.000001)) * 100 OR on() vector(0)",
          "refId": "A",
          "format": "time_series",
          "instant": true
        }
      ]
    },
    {
      "title": "p95 Latency",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
